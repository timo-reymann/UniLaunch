<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniLaunch.UI.App"
             Name="UniLaunch"
             xmlns:local="using:UniLaunch.UI"
             xmlns:assets="clr-namespace:UniLaunch.UI.Assets"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://UniLaunch.UI/Assets/window-icon.ico"
                      ToolTipText="UniLaunch"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{x:Static assets:Resources.TrayMenuOpen}"
                                        Click="OnOpen" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static local:AppVersion.MenuHeader}"
                                        IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static assets:Resources.TrayMenuExit}"
                                        Click="OnExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <StyleInclude Source="avares://UniLaunch.UI/Controls/TabItemWithIcon.axaml" />
        <StyleInclude Source="avares://UniLaunch.UI/Controls/TextInputWithFilePicker.axaml" />
        <StyleInclude Source="avares://UniLaunch.UI/Controls/Targets/WaitForNetworkConnectivityToggle.axaml" />
        <Style Selector="Menu>MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource MenuBar.PrimaryMenuItem.Foreground}" />
        </Style>
        <Style Selector="Menu>MenuItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground"
                    Value="{DynamicResource MenuBar.PrimaryMenuItem.Foreground}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="0 0 10 0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabStripItem">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="0 0 10 0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source='avares://UniLaunch.UI/Styles/LightThemeAdjustments.axaml' />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source='avares://UniLaunch.UI/Styles/DarkThemeAdjustments.axaml' />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="Syne">avares://UniLaunch.UI/Assets/Fonts#Lilita One</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>